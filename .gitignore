# generated artifacts — keep out of git (anchored to repo root so they
# never match same-named paths inside vendor/qlib)
/data/
/mlruns/
/.venv/
/venv/
/.pytest_cache/
/mlflow.db
__pycache__/
*.pyc

# qlib vendored-source build artifacts (regenerated by `pip install vendor/qlib`)
vendor/qlib/build/
vendor/qlib/*.egg-info/
vendor/qlib/qlib/_version.py
vendor/qlib/qlib/data/_libs/*.cpp
vendor/qlib/**/*.so
