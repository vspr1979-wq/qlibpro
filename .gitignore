# generated artifacts — keep out of git (anchored to the repository root so
# they never match same-named paths inside qlib/ or app/)
/data/
/mlruns/
/.venv/
/venv/
/.pytest_cache/
/mlflow.db
__pycache__/
*.pyc

# qlib source build artifacts (regenerated by `pip install ./qlib`)
/qlib/build/
/qlib/*.egg-info/
/qlib/qlib/_version.py
/qlib/qlib/data/_libs/*.cpp
/qlib/**/*.so
