# ─────────────────────────────────────────────────────────────
# QlibPro — environment configuration (copy to .env; never commit .env)
# ─────────────────────────────────────────────────────────────

# Port the QlibPro server listens on (bound to 0.0.0.0)
PORT=8787

# OPTIONAL: Groww Trading API access token (expires daily 06:00 IST).
# If unset, the app runs in PAPER mode and you can paste a token in the
# in-app Settings gear at any time — it is held in server memory only.
# Generate: groww.in → Profile → Settings → Trading APIs → Generate API Keys → Access Token
GROWW_ACCESS_TOKEN=

# OPTIONAL: override Groww API base URL (defaults to https://api.groww.in)
# GROWW_BASE_URL=https://api.groww.in
