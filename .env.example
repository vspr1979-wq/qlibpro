# ─────────────────────────────────────────────────────────────
# QlibPro — environment configuration (copy to .env; never commit .env)
# ─────────────────────────────────────────────────────────────

# Port the QlibPro server listens on (bound to 0.0.0.0)
PORT=8787

# OPTIONAL: Groww Trading API access token (expires daily 06:00 IST).
# If unset, the app runs in PAPER mode and you can paste a token in the
# in-app Settings gear at any time — it is held in server memory only.
# Generate: groww.in → Profile → Settings → Trading APIs → Generate API Keys → Access Token
GROWW_ACCESS_TOKEN=

# OPTIONAL: override Groww API base URL (defaults to https://api.groww.in)
# GROWW_BASE_URL=https://api.groww.in

# OPTIONAL: Groww API Key + Secret — "approval" flow (daily SHA-256 checksum auth).
# Groww → Profile → Settings → Trading APIs → Generate API key → copy Key & Secret.
# NOTE: Groww may require you to tap "Approve" on that page each day.
GROWW_API_KEY=
GROWW_API_SECRET=

# OPTIONAL (recommended for unattended bots): Groww TOTP flow — ZERO daily clicks.
# Groww → Profile → Settings → Trading APIs → Generate API key ▾ → Generate TOTP token.
# GROWW_TOTP_KEY    = the long TOTP *token* (JWT)
# GROWW_TOTP_SECRET = the Base32 TOTP *secret* (used server-side to compute the 6-digit code)
GROWW_TOTP_KEY=
GROWW_TOTP_SECRET=

# With TOTP env vars set the server mints + silently refreshes the daily access
# token on boot and every ~20h. Memory-only; nothing is written to disk.
